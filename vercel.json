{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "python entrenar_modelo.py",
  "functions": {
    "app.py": {
      "includeFiles": "modelo_vivienda.joblib",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/app.py"
    }
  ]
}
